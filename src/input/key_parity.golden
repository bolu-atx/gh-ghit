format | ' ' | format: true/false/false -> true/true/false
format | '0' | message:  -> recent: default query and window
format | '1' | message:  -> merged window: open + merged ≤1h ; window: 24 -> 1
format | '2' | message:  -> merged window: open + merged ≤24h
format | '3' | message:  -> merged window: open + merged ≤7d ; window: 24 -> 168
format | '4' | message:  -> merged window: open + merged all time ; window: 24 -> 0
format | '?' | shortcuts: false -> true
format | 'c' | show: truetruetruetruetrue -> truetruetruefalsetrue
format | 'e' | format: true/false/false -> true/true/false
format | 'f' | format: true/false/false -> false/false/false
format | 'g' | sort: Default/false/None -> Default/false/Milestone
format | 'i' | show: truetruetruetruetrue -> truetruefalsetruetrue
format | 'j' | format-focus: 0 -> 1
format | 'k' | format-focus: 0 -> 20
format | 'm' | show: truetruetruetruetrue -> truefalsetruetruetrue
format | 'o' | show: truetruetruetruetrue -> falsetruetruetruetrue
format | 'q' | format: true/false/false -> false/false/false
format | 's' | message:  -> no active query to save
format | enter | format: true/false/false -> true/true/false
format | esc | format: true/false/false -> false/false/false
format | up | format-focus: 0 -> 20
format | down | format-focus: 0 -> 1
format | g j | format-focus: 0 -> 1 ; sort: Default/false/None -> Default/false/Milestone
